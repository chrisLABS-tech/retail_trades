# Schwab developer app credentials — copy to scalper/.env and fill in.
# Register an app at https://developer.schwab.com, link your brokerage account,
# and complete the OAuth flow. NEVER commit the filled-in .env or token file.

# From your Schwab developer app
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Must match the callback URL configured on the Schwab app exactly.
# schwab-py examples use https://127.0.0.1:8182/
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/

# Where schwab-py persists the OAuth token (gitignored).
SCHWAB_TOKEN_PATH=scalper/token.json
